              "id": "I-PROC-ERRORS",
              "name": "VerboseErrorsOrResponsesLeakInternalDetail",
              "shortDescription": {
                "text": "Verbose errors or responses leak internal detail"
              },
              "fullDescription": {
                "text": "Sample Web App Service is internet-facing and may return verbose errors/stack traces that disclose internal structure to attackers."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/209.html",
              "help": {
                "text": "**Information disclosure** against `Sample Web App Service`.\n\nMitigation: Return generic error responses to clients; log detail server-side only; disable debug mode in production.\nControls: ASVS-7.4.1, ASVS-14.3.2\nWeakness: CWE-209\nOWASP Top 10: A05:2021 - Security Misconfiguration",
                "markdown": "**Information disclosure** against `Sample Web App Service`.\n\nMitigation: Return generic error responses to clients; log detail server-side only; disable debug mode in production.\nControls: ASVS-7.4.1, ASVS-14.3.2\nWeakness: CWE-209\nOWASP Top 10: A05:2021 - Security Misconfiguration"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "stride": "Information disclosure",
