            {
              "id": "DD-PROC-OVERCOLLECT",
              "name": "ProcessMayOver-collectOrOver-exposePersonalData",
              "shortDescription": {
                "text": "Process may over-collect or over-expose personal data"
              },
              "fullDescription": {
                "text": "Sample Web App Service handles personal data; without purpose limitation it can collect or expose more than necessary."
              },
              "helpUri": "https://owasp.org/www-community/Threat_Modeling",
              "help": {
                "text": "**Disclosure of information** against `Sample Web App Service`.\n\nMitigation: Apply purpose limitation and least-privilege access to personal data; redact fields not required for the operation.\nControls: GDPR-ART5-MIN, NIST-PT-3",
                "markdown": "**Disclosure of information** against `Sample Web App Service`.\n\nMitigation: Apply purpose limitation and least-privilege access to personal data; redact fields not required for the operation.\nControls: GDPR-ART5-MIN, NIST-PT-3"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
